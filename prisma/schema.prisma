// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECNICO
  CLIENTE
}

enum EstadoEquipo {
  ACTIVO
  INACTIVO
  EN_MANTENIMIENTO
  DADO_DE_BAJA
}

enum TipoMantenimiento {
  PREVENTIVO
  CORRECTIVO
}

enum EstadoMantenimiento {
  PROGRAMADO
  EN_PROCESO
  COMPLETADO
  CANCELADO
}

enum EstadoSolicitud {
  PENDIENTE
  EN_REVISION
  APROBADA
  RECHAZADA
  // Cancelada por el cliente, el técnico o el administrador. Es distinto de
  // RECHAZADA, que significa que el administrador denegó la solicitud: sin este
  // valor, una cancelación del cliente se presentaba con el rótulo "Rechazada".
  CANCELADA
}

/// Quién canceló un mantenimiento. Se guarda además del identificador del autor
/// porque decide si la cancelación descuenta carga histórica al técnico: solo
/// descuenta cuando no fue él quien canceló.
enum AutorCancelacion {
  CLIENTE
  TECNICO
  ADMIN
}

enum PrioridadSolicitud {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

model Empresa {
  id        String    @id @default(cuid())
  nombre    String
  nit       String    @unique
  contacto  String?
  telefono  String?
  email     String?
  direccion String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  usuarios  User[]
  equipos   Equipo[]

  @@map("empresas")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  nombre           String
  role             Role      @default(CLIENTE)
  empresaId        String?
  activo           Boolean   @default(true)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  empresa              Empresa?              @relation(fields: [empresaId], references: [id])
  mantenimientos       Mantenimiento[]       @relation("TecnicoMantenimientos")
  cancelaciones        Mantenimiento[]       @relation("CancelacionesMantenimiento")
  cancelacionesSolicitud SolicitudServicio[] @relation("CancelacionesSolicitud")
  historial            Historial[]
  solicitudes          SolicitudServicio[]   @relation("ClienteSolicitudes")

  @@map("users")
}

model Equipo {
  id          String       @id @default(cuid())
  tipo        String
  marca       String
  modelo      String?
  serial      String       @unique
  estado      EstadoEquipo @default(ACTIVO)
  ubicacion   String?
  empresaId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  empresa        Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  mantenimientos Mantenimiento[]
  historial      Historial[]
  solicitudes    SolicitudServicio[]

  @@map("equipos")
}

model Mantenimiento {
  id               String               @id @default(cuid())
  equipoId         String
  /// Opcional: un mantenimiento puede nacer sin técnico cuando la empresa del
  /// equipo no tiene ninguno activo, y el administrador puede retirárselo.
  tecnicoId        String?
  /// Solicitud que originó este mantenimiento. Nulo cuando lo creó el
  /// administrador desde el formulario. Único: una solicitud no puede acabar
  /// con dos mantenimientos.
  solicitudId      String?              @unique
  tipo             TipoMantenimiento
  estado           EstadoMantenimiento  @default(PROGRAMADO)
  fechaProgramada  DateTime
  fechaRealizada   DateTime?
  descripcion      String               @db.Text
  observaciones    String?              @db.Text
  reporteUrl       String?
  /// Motivo obligatorio al cancelar. Campo propio y no `observaciones`, porque
  /// aquel se borra cada vez que alguien cambia el estado con la caja vacía.
  motivoCancelacion String?             @db.Text
  canceladoPorId   String?
  canceladoPorRol  AutorCancelacion?
  canceladoEn      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  equipo     Equipo      @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  // La acción de borrado se declara a mano: al hacer `tecnicoId` opcional,
  // Prisma habría cambiado el valor por defecto de Restrict a SetNull y borrar
  // un técnico habría dejado sus mantenimientos huérfanos en silencio.
  tecnico    User?       @relation("TecnicoMantenimientos", fields: [tecnicoId], references: [id], onDelete: Restrict)
  // Restrict: no se puede borrar una solicitud que tenga mantenimiento vivo.
  solicitud  SolicitudServicio? @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  canceladoPor User?     @relation("CancelacionesMantenimiento", fields: [canceladoPorId], references: [id], onDelete: SetNull)
  historial  Historial[]
  alertas    Alerta[]

  @@map("mantenimientos")
}

model Historial {
  id                String    @id @default(cuid())
  equipoId          String
  mantenimientoId   String?
  tecnicoId         String
  fecha             DateTime  @default(now())
  observaciones     String    @db.Text

  equipo         Equipo         @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  mantenimiento  Mantenimiento? @relation(fields: [mantenimientoId], references: [id], onDelete: SetNull)
  tecnico        User           @relation(fields: [tecnicoId], references: [id])

  @@map("historial")
}

model Alerta {
  id                String    @id @default(cuid())
  mantenimientoId   String
  tipo              String
  mensaje           String    @db.Text
  enviada           Boolean   @default(false)
  fechaEnvio        DateTime?
  createdAt         DateTime  @default(now())

  mantenimiento Mantenimiento @relation(fields: [mantenimientoId], references: [id], onDelete: Cascade)

  @@map("alertas")
}

model SolicitudServicio {
  id          String              @id @default(cuid())
  equipoId    String
  clienteId   String
  descripcion String              @db.Text
  prioridad   PrioridadSolicitud  @default(MEDIA)
  estado      EstadoSolicitud     @default(PENDIENTE)
  respuesta   String?             @db.Text
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  /// Motivo, autor y fecha de la cancelación.
  ///
  /// Se guardan aquí y no solo en el mantenimiento porque la solicitud es el
  /// registro del cliente y tiene que sobrevivirle: si se elimina el
  /// mantenimiento, una solicitud cancelada perdería el motivo y el autor, y el
  /// requisito de que el cliente vea quién canceló y por qué sería imposible de
  /// cumplir. Se escriben en la misma transacción que los del mantenimiento.
  motivoCancelacion String?           @db.Text
  canceladoPorId    String?
  canceladoPorRol   AutorCancelacion?
  canceladoEn       DateTime?

  equipo      Equipo              @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  cliente     User                @relation("ClienteSolicitudes", fields: [clienteId], references: [id])
  canceladaPor User?              @relation("CancelacionesSolicitud", fields: [canceladoPorId], references: [id], onDelete: SetNull)
  /// Lado inverso del enlace. Es a lo sumo uno: `Mantenimiento.solicitudId` es
  /// único.
  mantenimiento Mantenimiento?

  @@map("solicitudes_servicio")
}

/// Parámetros de operación que el administrador ajusta desde la aplicación.
///
/// Fila única con columnas tipadas, no clave/valor: los tipos salen gratis y la
/// validación del rango vive junto al valor. Nadie crea esta fila —el
/// repositorio no tiene semilla ni script de siembra de Prisma— así que la
/// lectura tiene que resolver el valor por defecto por sí sola.
model Configuracion {
  id                 String   @id @default("unica")
  /// Días de adelanto con que se programa un mantenimiento nacido de una
  /// solicitud. Acotado por validación al rango que la ventana de avisos
  /// soporta: por debajo nace vencido, por encima no aparece en ningún aviso.
  diasProgramacion   Int      @default(3)
  updatedAt          DateTime @updatedAt

  @@map("configuracion")
}
